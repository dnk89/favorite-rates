{
  "ReverseProxy": {
    "Routes": {
      "users-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/users-service/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/users-service" },
          { "X-Forwarded": "Set", "Prefix": "Off" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/users-service" }
        ]
      },
      "finance-route": {
        "ClusterId": "finance-cluster",
        "Match": {
          "Path": "/finance-service/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/finance-service" },
          { "X-Forwarded": "Set", "Prefix": "Off" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/finance-service" }
        ]
      }
    },
    "Clusters": {
      "users-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5145" }
        }
      },
      "finance-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5062" }
        }
      }
    }
  }
}
